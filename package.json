{
  "name": "sigfox-js",
  "version": "0.0.0-development",
  "description": "Typed, zero-dependency client for the Sigfox API v2",
  "keywords": [
    "sigfox",
    "iot",
    "lpwan",
    "api",
    "client",
    "typescript"
  ],
  "author": "David Montoro <davidmontoro1993@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/septk/sigfox.js.git"
  },
  "homepage": "https://github.com/septk/sigfox.js#readme",
  "bugs": "https://github.com/septk/sigfox.js/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "docs": "typedoc",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.5",
    "semantic-release": "^25.0.9",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release": {
    "branches": [
      "master"
    ]
  }
}
